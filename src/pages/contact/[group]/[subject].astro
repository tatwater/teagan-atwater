---
import ContactLayout from '@/layouts/ContactLayout.astro';
import ContactMain from '@/islands/contact/ContactMain';
import { getUserInfo } from '@/lib/auth';
import { getConvexClient } from '@/lib/convex';
import { api } from '../../../../convex/_generated/api';
import { findSubject } from '@/data/contact';

const { group: groupSlug, subject: subjectSlug } = Astro.params;

const found = findSubject(groupSlug!, subjectSlug!);
if (!found) return Astro.redirect('/contact/hire', 302);

const { group: groupData, subject: subjectData } = found;

const userInfo = getUserInfo(Astro.locals);
const convex = getConvexClient();

let userEmail: string | undefined;
let userProfile: {
  firstName?: string;
  lastName?: string;
  displayName?: string;
  phone?: string;
  organization?: string;
  profileComplete?: boolean;
} | null = null;
let isAvailable = true;
let isNotificationSubscribed = false;
let availabilityMap: Record<string, boolean> = {};

if (userInfo.isAuthenticated && userInfo.userId) {
  let clerkFirstName: string | undefined;
  let clerkLastName: string | undefined;

  try {
    const currentUser = await Astro.locals.currentUser();
    if (currentUser) {
      userEmail =
        currentUser.emailAddresses?.find(
          (e) => e.id === currentUser.primaryEmailAddressId
        )?.emailAddress ?? undefined;
      clerkFirstName = currentUser.firstName || undefined;
      clerkLastName = currentUser.lastName || undefined;
    }
  } catch {
    // non-fatal
  }

  try {
    const profile = await convex.query(api.userProfile.getUserProfile, {
      clerkId: userInfo.userId,
    });
    userProfile = {
      firstName: profile?.firstName || clerkFirstName,
      lastName: profile?.lastName || clerkLastName,
      displayName: profile?.displayName,
      phone: profile?.phone,
      organization: profile?.organization,
      profileComplete: profile?.profileComplete ?? false,
    };
  } catch {
    // non-fatal
  }

  if (!subjectData.alwaysAvailable) {
    try {
      const sub = await convex.query(api.notifications.isSubscribed, {
        userId: userInfo.userId,
        group: groupSlug,
        subject: subjectSlug!,
      });
      isNotificationSubscribed = sub;
    } catch {
      // non-fatal
    }
  }
}

if (!subjectData.alwaysAvailable) {
  try {
    const avail = await convex.query(api.availability.getAvailability, {
      group: groupSlug,
      subject: subjectSlug!,
    });
    isAvailable = avail?.isAvailable ?? true;
  } catch {
    isAvailable = true;
  }
}

try {
  const allAvail = await convex.query(api.availability.getAllAvailability, {});
  for (const record of allAvail) {
    const key = `${record.group ?? ''}/${record.subject}`;
    availabilityMap[key] = record.isAvailable;
  }
} catch {
  // non-fatal — layout falls back to available
}
---

<ContactLayout
  title={`${subjectData.label} — ${groupData.label}`}
  activeGroup={groupSlug!}
  activeSubject={subjectSlug!}
  availabilityMap={availabilityMap}
>
  <ContactMain
    client:only="react"
    subjectData={subjectData}
    groupLabel={groupData.label}
    group={groupSlug!}
    isAuthenticated={userInfo.isAuthenticated}
    userId={userInfo.userId}
    userEmail={userEmail}
    userProfile={userProfile}
    isAvailable={isAvailable}
    isNotificationSubscribed={isNotificationSubscribed}
  />
</ContactLayout>

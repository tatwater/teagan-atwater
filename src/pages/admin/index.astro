---
import Layout from '../../layouts/Layout.astro';
import { requireAdmin } from '../../lib/auth';

const userInfo = requireAdmin(Astro.locals);
---

<Layout title="Admin">
  <div class="max-w-4xl mx-auto px-6 py-10">

    <!-- Header -->
    <div class="flex items-start justify-between gap-4 mb-10">
      <div>
        <h1 class="font-glyph text-3xl">Admin</h1>
        <p class="text-xs text-muted-foreground mt-1">Contact messages and site settings</p>
      </div>
      <a
        href="/admin/availability"
        class="text-xs text-muted-foreground underline underline-offset-2 shrink-0 mt-1"
      >
        Availability settings →
      </a>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-4 gap-px border border-border mb-8 bg-border">
      {[
        { id: 'total-count', label: 'Total' },
        { id: 'new-count',   label: 'New',      color: 'text-primary' },
        { id: 'replied-count', label: 'Replied', color: 'text-emerald-500' },
        { id: 'archived-count', label: 'Archived' },
      ].map(({ id, label, color }) => (
        <div class="bg-background px-5 py-4">
          <p class="text-[10px] font-mono uppercase tracking-widest text-muted-foreground mb-1">
            {label}
          </p>
          <p id={id} class:list={['text-2xl font-glyph', color ?? 'text-foreground']}>—</p>
        </div>
      ))}
    </div>

    <!-- Filters -->
    <div class="flex gap-3 mb-4">
      <input
        type="text"
        id="search"
        placeholder="Search by subject or email…"
        class="flex-1 h-8 border border-input bg-transparent px-2.5 text-xs placeholder:text-muted-foreground outline-none focus-visible:border-ring focus-visible:ring-1 focus-visible:ring-ring/50 transition-colors"
      />
      <select
        id="status-filter"
        class="h-8 border border-input bg-transparent px-2.5 text-xs text-foreground outline-none focus-visible:border-ring focus-visible:ring-1 focus-visible:ring-ring/50 transition-colors"
      >
        <option value="">All statuses</option>
        <option value="new">New</option>
        <option value="read">Read</option>
        <option value="replied">Replied</option>
        <option value="archived">Archived</option>
      </select>
    </div>

    <!-- Messages table -->
    <div id="table-wrapper" class="border border-border">
      <table class="w-full text-xs">
        <thead>
          <tr class="border-b border-border">
            <th class="px-4 py-2.5 text-left font-mono uppercase tracking-widest text-muted-foreground font-normal w-20">Status</th>
            <th class="px-4 py-2.5 text-left font-mono uppercase tracking-widest text-muted-foreground font-normal">From</th>
            <th class="px-4 py-2.5 text-left font-mono uppercase tracking-widest text-muted-foreground font-normal">Subject</th>
            <th class="px-4 py-2.5 text-left font-mono uppercase tracking-widest text-muted-foreground font-normal w-28">Date</th>
            <th class="px-4 py-2.5 text-right font-mono uppercase tracking-widest text-muted-foreground font-normal w-16">Replies</th>
            <th class="px-4 py-2.5 w-12"></th>
          </tr>
        </thead>
        <tbody id="messages-tbody">
          <tr>
            <td colspan="6" class="px-4 py-10 text-center text-muted-foreground text-xs">
              Loading…
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Empty state -->
    <div id="empty-state" class="hidden border border-border px-6 py-12 text-center">
      <p class="text-sm text-muted-foreground">No messages match your filters.</p>
    </div>

    <!-- Error state -->
    <div id="error-state" class="hidden border border-destructive/40 bg-destructive/5 px-6 py-8 text-center">
      <p class="text-xs text-destructive mb-3">Failed to load messages.</p>
      <button
        onclick="location.reload()"
        class="text-xs underline underline-offset-2 text-muted-foreground"
      >
        Try again
      </button>
    </div>

  </div>
</Layout>

<script>
  interface ContactMessage {
    _id: string;
    userEmail: string;
    userName?: string;
    subject: string;
    status: 'new' | 'read' | 'replied' | 'archived';
    submittedAt: number;
    replyCount: number;
  }

  let allMessages: ContactMessage[] = [];

  const STATUS_COLORS: Record<string, string> = {
    new: 'text-primary',
    read: 'text-muted-foreground',
    replied: 'text-emerald-500',
    archived: 'text-muted-foreground',
  };

  function escapeHtml(text: string) {
    const d = document.createElement('div');
    d.textContent = text;
    return d.innerHTML;
  }

  function applyFilters() {
    const search = (document.getElementById('search') as HTMLInputElement).value.toLowerCase();
    const status = (document.getElementById('status-filter') as HTMLSelectElement).value;

    const filtered = allMessages.filter((m) => {
      if (status && m.status !== status) return false;
      if (search) {
        return (
          m.subject.toLowerCase().includes(search) ||
          m.userEmail.toLowerCase().includes(search) ||
          m.userName?.toLowerCase().includes(search)
        );
      }
      return true;
    });

    render(filtered);
  }

  function render(messages: ContactMessage[]) {
    const tbody = document.getElementById('messages-tbody')!;
    const tableWrapper = document.getElementById('table-wrapper')!;
    const emptyState = document.getElementById('empty-state')!;

    if (messages.length === 0) {
      tableWrapper.classList.add('hidden');
      emptyState.classList.remove('hidden');
      return;
    }

    tableWrapper.classList.remove('hidden');
    emptyState.classList.add('hidden');

    tbody.innerHTML = messages.map((m) => {
      const date = new Date(m.submittedAt).toLocaleDateString('en-US', {
        month: 'short', day: 'numeric', year: 'numeric',
      });
      const colorClass = STATUS_COLORS[m.status] ?? '';

      return `
        <tr class="border-b border-border last:border-0 hover:bg-muted/30 transition-colors">
          <td class="px-4 py-3">
            <span class="font-mono text-[10px] uppercase tracking-widest ${colorClass}">${m.status}</span>
          </td>
          <td class="px-4 py-3">
            <p class="font-medium">${escapeHtml(m.userName || '—')}</p>
            <p class="text-muted-foreground">${escapeHtml(m.userEmail)}</p>
          </td>
          <td class="px-4 py-3 max-w-xs truncate text-muted-foreground">
            ${escapeHtml(m.subject)}
          </td>
          <td class="px-4 py-3 text-muted-foreground whitespace-nowrap">${date}</td>
          <td class="px-4 py-3 text-right text-muted-foreground">
            ${m.replyCount > 0 ? m.replyCount : '—'}
          </td>
          <td class="px-4 py-3 text-right">
            <a href="/admin/contact/${m._id}" class="underline underline-offset-2 text-muted-foreground hover:text-foreground transition-colors">
              View
            </a>
          </td>
        </tr>
      `;
    }).join('');
  }

  async function loadMessages() {
    try {
      const res = await fetch('/api/admin/contacts');
      if (!res.ok) throw new Error('Failed');
      const data = await res.json();
      allMessages = data.messages || [];

      const total = allMessages.length;
      const counts = { new: 0, replied: 0, archived: 0 };
      for (const m of allMessages) {
        if (m.status in counts) counts[m.status as keyof typeof counts]++;
      }

      document.getElementById('total-count')!.textContent = String(total);
      document.getElementById('new-count')!.textContent = String(counts.new);
      document.getElementById('replied-count')!.textContent = String(counts.replied);
      document.getElementById('archived-count')!.textContent = String(counts.archived);

      applyFilters();
    } catch {
      document.getElementById('table-wrapper')!.classList.add('hidden');
      document.getElementById('error-state')!.classList.remove('hidden');
    }
  }

  document.getElementById('search')?.addEventListener('input', applyFilters);
  document.getElementById('status-filter')?.addEventListener('change', applyFilters);

  loadMessages();
</script>

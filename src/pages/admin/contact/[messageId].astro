---
import Layout from '../../../layouts/Layout.astro';
import { requireAdmin } from '../../../lib/auth';
import AdminMessageDetail from '../../../islands/AdminMessageDetail';

const userInfo = requireAdmin(Astro.locals);

const { messageId } = Astro.params;
if (!messageId) return Astro.redirect('/admin', 302);
---

<Layout title="Message — Admin">
  <div class="max-w-2xl mx-auto px-6 py-10">
    <a
      href="/admin"
      class="text-xs text-muted-foreground underline underline-offset-2 mb-8 inline-block"
    >
      ← Admin
    </a>

    <AdminMessageDetail
      client:load
      messageId={messageId}
      adminId={userInfo.userId!}
    />
  </div>
</Layout>

---
import ProfileLayout from '@/layouts/ProfileLayout.astro';
import { SecuritySection } from '@/islands/profile/SecuritySection';
import { getUserInfo } from '@/lib/auth';

const userInfo = getUserInfo(Astro.locals);
if (!userInfo.isAuthenticated) return Astro.redirect('/sign-in?redirect_url=/profile/security', 302);
---

<ProfileLayout title="Security — Profile Settings">
  <SecuritySection client:load />
</ProfileLayout>

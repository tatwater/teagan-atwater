---
import Layout from '@/layouts/Layout.astro';
import ContactForm from '@/islands/contact/ContactForm';

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<Layout>
  <div class='px-4 md:px-6 py-10 md:py-16'>
    <div class='max-w-2xl mx-auto'>
      <h1 class='font-glyph text-2xl md:text-3xl'>
        Get in touch
      </h1>
      <p class='mt-3 text-sm text-muted-foreground'>
        Have a project, a question, or just want to say hello? Send me a note and
        I&rsquo;ll get back to you.
      </p>

      <div class='mt-10'>
        <ContactForm client:load turnstileSiteKey={turnstileSiteKey} />
      </div>
    </div>
  </div>
</Layout>

---
import Layout from '@/layouts/Layout.astro';
import ContactForm from '@/islands/contact/ContactForm';

// Nothing here is request-specific: Vite inlines `import.meta.env.PUBLIC_*` at
// build time, so rendering on demand only bought a cold serverless invocation
// for a value that was already frozen into the bundle. Prerendered, this is a
// static file with an ETag that prefetch can actually reuse. The form still
// posts to /api/contact/submit, which stays on demand.
export const prerender = true;

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<Layout>
  <div class='px-4 md:px-6 pt-10 md:pt-16 page-runout'>
    <div class='max-w-2xl mx-auto'>
      <h1 class='font-glyph text-2xl md:text-3xl'>
        Get in touch
      </h1>
      <p class='mt-3 text-sm text-muted-foreground'>
        Have a project, a question, or just want to say hello? Send me a note and
        I&rsquo;ll get back to you.
      </p>

      <div class='mt-10'>
        <ContactForm client:load turnstileSiteKey={turnstileSiteKey} />
      </div>
    </div>
  </div>
</Layout>

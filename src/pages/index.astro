---
import type { ReelItem } from '@/islands/home-reel';

import Layout from '@/layouts/Layout.astro';
import HomeReel from '@/islands/home-reel';
import { highlights } from '@/data/highlights';
import { mockupsFor } from '@/lib/mockups';

// Only the reel's own fields cross into the island, so the home page does not
// pull the whole résumé data set into its client bundle. Mockup URLs resolve
// here, at build time, where Vite has already hashed them.
const items: ReelItem[] = highlights.map((highlight) => ({
  accent: highlight.accent,
  id: highlight.id,
  name: highlight.name,
  shots: mockupsFor(highlight.id, highlight.name),
  tagline: highlight.tagline,
}));
---

<Layout>
  <HomeReel client:load items={items} />
</Layout>

---
import Layout from '@/layouts/Layout.astro';
import { projectItems } from '@/data/resume/projects';

// Stub: the right-hand pane will become a series of image slides showing UI
// mockups on devices in the real world. Placeholders stand in until those exist.
const projects = projectItems.filter((project) => !project.hidden);
const SLIDE_COUNT = 3;
---

<Layout>
  <div class='flex flex-col lg:flex-row min-h-[calc(100vh-4rem-1px)]'>

    <!-- Sidebar: projects -->
    <aside class='w-full lg:w-72 xl:w-80 shrink-0 border-b lg:border-b-0 lg:border-r border-border-light'>
      <div class='lg:sticky lg:top-0 flex flex-col gap-4 p-6'>
        <span class='text-[10px] font-mono uppercase tracking-widest text-muted-foreground'>
          Projects
        </span>

        <ul class='flex flex-col'>
          {projects.map((project) => (
            <li>
              <a
                class='group flex flex-col gap-0.5 border-l border-transparent py-2.5 pl-3 -ml-px transition-colors hover:border-primary hover:bg-muted/40'
                href={`/resume/${project.detailId ?? project.id}`}
              >
                <span class='text-sm font-medium text-foreground leading-snug'>
                  {project.title}
                </span>
                <span class='text-xs text-muted-foreground leading-snug'>
                  {project.descriptionHeadline}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </aside>

    <!-- Slides -->
    <div class='flex-1 min-w-0 p-6 md:p-10'>
      <div class='flex flex-col gap-6'>
        {Array.from({ length: SLIDE_COUNT }).map((_, i) => (
          <div
            aria-hidden='true'
            class='flex aspect-16/10 w-full items-center justify-center border border-dashed border-border bg-muted/20'
          >
            <span class='text-[10px] font-mono uppercase tracking-widest text-muted-foreground/60'>
              Slide {i + 1} — mockup pending
            </span>
          </div>
        ))}
      </div>
    </div>

  </div>
</Layout>

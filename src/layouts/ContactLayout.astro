---
import Layout from '@/layouts/Layout.astro';
import { Avatar } from '@/components/avatar';
import { ContactKeyboardHints } from '@/islands/contact/ContactKeyboardHints';
import { CONTACT_GROUPS, subjectUrl } from '@/data/contact';

interface Props {
  title: string;
  activeGroup: string | null;
  activeSubject: string;
  availabilityMap?: Record<string, boolean>;
}

const { title, activeGroup, activeSubject, availabilityMap = {} } = Astro.props;
---

<Layout title={title}>
  <div class="grid grid-cols-[max-content_1fr] min-h-[calc(100vh-4rem-1px)]">
    <!-- Sidebar -->
    <nav class="px-4 pt-8 flex flex-col gap-8 border-r border-border-light w-56 xl:w-65">
      {CONTACT_GROUPS.map((group) => {
        const isGroupActive = group.slug === activeGroup;
        return (
          <div class="flex flex-col gap-2">
            <div class="flex items-center gap-2.5">
              <Avatar
                client:load
                transition:persist={`contact-avatar-${group.slug ?? 'teagan'}`}
                alt={group.label}
                fallback={group.avatarFallback}
                shape={group.avatarShape}
                size="sm"
                src={group.avatarSrc}
              />
              <span class="text-base font-sans">{group.label}</span>
            </div>
            <div class="ml-3 border-l border-border-light">
              {group.subjects.map((subject) => {
                const isActive = isGroupActive && subject.slug === activeSubject ||
                  group.slug === null && activeGroup === null && subject.slug === activeSubject;
                const url = subjectUrl(group.slug, subject.slug);
                const availKey = `${group.slug ?? ''}/${subject.slug}`;
                const isAvailable = subject.alwaysAvailable || (availabilityMap[availKey] ?? true);
                const glowColor = isAvailable ? 'var(--primary)' : 'var(--destructive)';
                return (
                  <a
                    href={url}
                    class:list={[
                      'flex flex-col gap-0.5 pl-5.5 py-2 transition-colors group relative',
                      isActive
                        ? 'text-foreground'
                        : 'text-muted-foreground hover:text-foreground',
                    ]}
                    style={isActive ? `background: radial-gradient(ellipse 20% 48% at -2% 50%, color-mix(in oklch, ${glowColor} 8%, transparent) 8%, transparent 100%)` : undefined}
                    aria-current={isActive ? 'page' : undefined}
                  >
                    {isActive && (
                      <span class:list={[
                        'absolute left-0 top-1 w-px h-[calc(100%-0.5rem)] -translate-x-px',
                        isAvailable ? 'bg-primary' : 'bg-destructive',
                      ]} />
                    )}
                    <span class:list={[
                      'text-sm',
                      // 'text-[10px] font-mono uppercase tracking-widest',
                      isActive
                        ? (isAvailable ? 'text-primary' : 'text-destructive')
                        : 'text-muted-foreground group-hover:text-foreground',
                    ]}>
                      {subject.label}
                    </span>
                    <span class="text-xs">{subject.subtitle}</span>
                  </a>
                );
              })}
            </div>
          </div>
        );
      })}
      <ContactKeyboardHints
        client:only="react"
        activeGroup={activeGroup}
        activeSubject={activeSubject}
      />
    </nav>

    <!-- Main content -->
    <div class="min-w-0 w-full">
      <slot />
    </div>
  </div>
</Layout>

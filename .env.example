# Convex
CONVEX_DEPLOYMENT=
PUBLIC_CONVEX_URL=

# Resend (Email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Cloudflare Turnstile (contact form spam protection)
# Verification is skipped when TURNSTILE_SECRET_KEY is unset in development.
# In production a missing secret rejects submissions instead of accepting
# unverified traffic — the form emails a receipt to a user-supplied address,
# so leaving it open would make the site a spam relay. Set both keys before
# deploying, and set them for the Production environment (not preview-only).
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Site Configuration
PUBLIC_SITE_URL=http://localhost:4321

# Where contact form submissions are delivered
ADMIN_EMAIL=

# Private FontAwesome registry token (required to install dependencies)
FONTAWESOME_NPM_TOKEN=
